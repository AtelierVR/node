// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

/// User session for authentication (token-based, can be device-bound)
model Session {
  id          String   @id @default(uuid())
  token       String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int      @map("user_id")
  publicKey   Bytes?   @map("public_key") // SPKI DER — Ed25519 public key (~44 bytes)
  fingerprint String?  @map("fingerprint") // Optional device fingerprint for additional security
  expires     DateTime
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  devices     Device[]

  @@map("sessions")
}

/// Device associated with a session (browser, app, etc.)
model Device {
  id        Int      @id @default(autoincrement())
  sessionId String   @map("session_id")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ip        String
  userAgent String?  @map("user_agent")
  lastSeen  DateTime @default(now()) @map("last_seen")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sessionId, ip, userAgent], name: "unique_device")
  @@map("devices")
}

/// WebAuthn / passkey credential registered by a user.
/// A user can have several (one per device / authenticator).
model Passkey {
  id           String    @id @default(uuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int       @map("user_id")
  /// base64url-encoded credential ID (unique across all users)
  credentialId String    @unique @map("credential_id")
  /// base64url-encoded COSE public key
  publicKey    String    @map("public_key")
  /// Signature counter — used to detect cloned authenticators
  counter      BigInt    @default(0)
  /// Authenticator transports (usb, nfc, ble, internal, hybrid…)
  transports   String[]  @default([])
  /// Resident/discoverable key — enables usernameless login
  discoverable Boolean   @default(false) @map("discoverable")
  /// "singleDevice" | "multiDevice"
  deviceType   String    @default("singleDevice") @map("device_type")
  /// Whether the credential is synced/backed up (multi-device)
  backedUp     Boolean   @default(false) @map("backed_up")
  /// Authenticator AAGUID (identifies the authenticator model)
  aaguid       String?
  /// User-provided label (e.g. "My laptop")
  name         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  @@index([userId])
  @@map("passkeys")
}

datasource db {
  provider = "postgresql"
}

/// Short presence statuses exposed on user profiles.
/// Who may see the `locations` field per status is driven by the bit flags in
/// `PresenceVisibility` (see `src/users/users.types.ts`). Visibility ladder
/// (least → most): offline > dnd/stream > busy > online/event > public.
enum PresenceStatus {
  ONLINE // green  — location shared with relations (friends/followers/following)
  BUSY // orange — location shared with mutual friends
  DO_NOT_DISTURB // red    — DND, location hidden
  STREAM // purple — streaming, location hidden (same as DND)
  OFFLINE // grey   — no location, no status
  EVENT // yellow — online during an event, same visibility as ONLINE
  PUBLIC // cyan   — location shared with everyone (aka join_all)

  @@map("presence_status")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

/// User account with Ed25519 identity certificate.
/// cert_pub / cert_priv store SPKI / PKCS#8 DER-encoded Ed25519 keys.
model User {
  id             Int            @id @default(autoincrement())
  username       String         @unique
  display        String
  bio            String?
  pronoun        String?
  email          String?        @unique
  emailVerified  Boolean        @default(false) @map("email_verified")
  password       String?
  rank           Float          @default(0)
  tags           String[]
  thumbnail      String?
  banner         String?
  links          Json           @default("[]")
  blacklisted    Json?
  homeRef        String?        @map("home_ref")
  avatarRef      String?        @map("avatar_ref")
  twofaEnabled   Boolean        @default(false) @map("twofa_enabled")
  twofaSecret    String?        @map("twofa_secret")
  presence       PresenceStatus @default(ONLINE)
  presenceStatus String?        @map("presence_status")
  /// SPKI DER — Ed25519 public key (~44 bytes)
  public         Bytes          @map("public")
  /// PKCS#8 DER — Ed25519 private key (~48 bytes)
  private        Bytes          @map("private")
  expiresKey     DateTime       @map("expires_keys")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  sessions      Session[]
  verifications Verification[]
  passkeys      Passkey[]
  tables        UserTable[]

  @@map("users")
}

/// Relation type between two users.
enum UserRelationType {
  FOLLOW // Accepted follow
  REQUEST // Pending follow request (requires manual validation)

  @@map("user_relation_type")
}

/// Unidirectional relation between two users identified by NoxIdentifier strings.
/// One relation per direction: @@unique([initiatorRef, targetRef]).
model UserRelation {
  id           String           @id @default(cuid())
  type         UserRelationType
  /// NoxIdentifier of the user who initiated the relation (e.g. "1@::" or "1@example.com")
  initiatorRef String           @map("initiator_ref")
  /// NoxIdentifier of the relation target (e.g. "2@::" or "2@other.com")
  targetRef    String           @map("target_ref")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([initiatorRef, targetRef])
  @@map("user_relations")
}

/// Key/value store owned by a user. Keys follow dot-notation (e.g. "nox.worlds.favorites").
/// Public entries use the prefix "public." and are readable by anyone.
model UserTable {
  key       String
  userId    Int      @map("user_id")
  value     Bytes
  mime      String   @default("application/octet-stream")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([key, userId])
  @@map("user_tables")
}

/// Stores runtime config overrides loaded by AppConfigService.
/// Keys use dot-notation matching the AppConfig structure (e.g. "http.port").
/// Priority: Database > Config (YAML) > Env > Default
model Config {
  /// Dot-notation key, e.g. "http.port", "http.host"
  key       String   @id
  /// Raw string value — coerced to the correct type on read
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("configs")
}

/// Generic verification entry — handles MFA codes (email/passkey) and email confirmation tokens.
///   type="email_code"   → MFA 6-digit code, expires in 10 min, validated on use
///   type="passkey_code" → MFA 6-digit code minted after a passkey assertion, expires in 30 s, validated on use
///   type="email_link"   → clickable link token, expires in 24h, validated when user clicks
model Verification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  code      String
  expires   DateTime
  validated Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("verifications")
}

/// Generic notification between users (requests, invites, alerts, etc.).
/// Persisted so the receiver can process it later (even if offline at send time).
model Notification {
  id           Int      @id @default(autoincrement())
  type         String
  key          String?
  data         Json?
  by           String?
  to           String
  expiresAt    DateTime @map("expires_at")
  isReceived   Boolean  @default(false)
  delivered    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([by])
  @@index([to])
  @@map("notifications")
}

model ExternalServer {
  id        Int            @id @default(autoincrement())
  rank      Float          @default(0)
  address   String         @unique
  public    Bytes          @unique @map("public")
  lastSeen  DateTime       @default(now()) @map("last_seen")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  users     ExternalUser[]

  @@map("external_servers")
}

model ExternalUser {
  id          Int
  public      Bytes          @map("public")
  rank        Float          @default(0)
  tags        String[]
  blacklisted Json?
  serverId    Int            @map("server_id")
  server      ExternalServer @relation(fields: [serverId], references: [id])
  lastSeen    DateTime       @default(now()) @map("last_seen")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@id([id, serverId])
  @@map("external_users")
}

/// Provider-independent metadata for an asset.
/// Provider-specific runtime context is hydrated from the cache.
model Asset {
  /// Auto-incremented id, unique **per type**: the primary key is `(type, id)`.
  id Int @default(autoincrement())

  releases AssetRelease[]

  provider String
  type     String

  name        String?
  title       String?
  description String?
  tags        String[] @default([])

  owner       String   @map("owner_ref")
  contributor String[] @default([]) @map("contributor_refs")

  metadata Json @default("{}")
  /// Ordered list of asset images: `[{ key?, url?, alt?, priority? }]`.
  /// Local images reference a stored file; the file metadata (dimensions, …) is
  /// persisted by the storage provider alongside the file itself.
  images   Json @default("[]")

  /// Preferred release id exposed by the API. `null` = auto (the latest release).
  release Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([type, id])
  @@unique([type, provider, name])
  @@map("assets")
}

/// A published version mirrored from an asset provider.
model AssetRelease {
  /// Auto-incremented id, unique **per asset**: the primary key is `(assetType, assetId, id)`.
  id Int @default(autoincrement())

  assetType String      @map("asset_type")
  assetId   Int         @map("asset_id")
  asset     Asset       @relation(fields: [assetType, assetId], references: [type, id], onDelete: Cascade)
  files     AssetFile[]

  name      String?
  title     String?
  changelog String?
  channel   AssetReleaseChannel

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([assetType, assetId, id])
  @@unique([assetType, assetId, name])
  @@map("asset_releases")
}

enum AssetReleaseChannel {
  stable
  candidate
  nightly

  @@map("asset_release_channel")
}

/// Downloadable file advertised by a release.
model AssetFile {
  id Int @id @default(autoincrement())

  releaseAssetType String       @map("release_asset_type")
  releaseAssetId   Int          @map("release_asset_id")
  releaseId        Int          @map("release_id")
  release          AssetRelease @relation(fields: [releaseAssetType, releaseAssetId, releaseId], references: [assetType, assetId, id], onDelete: Cascade)

  name   String?
  url    String
  size   BigInt
  mime   String
  /// Free-form attributes (`[{ key, value }]`), e.g. platform/engine.
  attributes Json @default("[]")
  hashes String[] @default([])

  uploader String? @map("uploader_ref")

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([releaseAssetType, releaseAssetId, releaseId, name])
  @@map("asset_files")
}

/// Server-side activity/audit log.
/// Stores important events surfaced to admins via GET /api/activity.
model ActivityEvent {
  id        Int      @id @default(autoincrement())
  /// Dot-namespaced event type (e.g. "world.upload", "node.ready", "maintenance.started")
  type      String
  message   String
  details   Json?
  /// NoxIdentifier string of the author (e.g. "u:1@::", "system")
  authorRef String?  @map("author_ref")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([createdAt])
  @@map("activity_events")
}

/// Retained for compatibility with the existing tickets table and migrations.
model Ticket {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  status      TicketStatus @default(OPEN)
  priority    String       @default("medium")
  category    String       @default("other")
  email       String
  assigneeId  Int?         @map("assignee_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("tickets")
}

/// A relay server connected to this node to host world instances.
model Relay {
  id         Int             @id @default(autoincrement())
  /// Human-readable label for this relay (e.g. "EU-West #1")
  label      String?
  /// Runner provider type: "docker" | "external" | "kubernetes" | "proxmox"
  provider   String          @default("docker")
  /// Provider-specific resource identifier (e.g. Docker container ID)
  providerId String?         @map("provider_id")
  /// Maximum number of instances this relay can host (updated at runtime by the relay binary)
  maxLink    Int             @default(3) @map("max_link")
  token      RelayToken?
  tags       String[]        @default([])
  links      RelayInstance[]
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@map("relays")
}

/// Join table linking a relay to the instances it hosts.
/// Each instance can be assigned to at most one relay at a time (instanceId is unique).
model RelayInstance {
  id         Int      @id @default(autoincrement())
  relayId    Int      @map("relay_id")
  relay      Relay    @relation(fields: [relayId], references: [id], onDelete: Cascade)
  instanceId Int      @unique @map("instance_id")
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([relayId])
  @@map("relay_instances")
}

/// Authentication token used by a relay to connect via WebSocket.
model RelayToken {
  id      Int    @id @default(autoincrement())
  token   String @unique
  relayId Int    @unique @map("relay_id")
  relay   Relay  @relation(fields: [relayId], references: [id], onDelete: Cascade)

  @@map("relay_tokens")
}

/// A hosted world instance (running room) managed by a relay.
model Instance {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  title         String?
  description   String?
  capacity      Int            @default(10)
  /// NoxIdentifier of the world (e.g. "1@::")
  worldRef      String         @map("world_ref")
  /// NoxIdentifier of the owner user (e.g. "1@::")
  ownerRef      String         @map("owner_ref")
  tags          String[]
  thumbnail     String?
  useWhitelist  Boolean        @default(false) @map("use_whitelist")
  whitelistRefs String[]       @default([]) @map("whitelist_refs")
  usePassword   Boolean        @default(false) @map("use_password")
  password      String?
  /// Back-reference to the relay assignment (null when not yet assigned)
  link          RelayInstance?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("instances")
}
