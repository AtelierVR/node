    "@prisma/client": "^6.5.0",
    "@types/dockerode": "^3.3.31",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.8",
    "@types/node-forge": "^1.3.13",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/ws": "^8.5.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "ajv": "^8.17.1",
