{
  "name": "node",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/src/index.js",
    "build-image": "docker build -t hactazia/noxnode -t noxnode .",
    "dev": "npx ts-node src/index.ts",
    "migrate": "npx prisma migrate dev --name \"init\"",
    "deploy": "npx prisma migrate deploy",
    "generate": "npx prisma generate",
    "compose": "docker compose down && npm run build-image && docker compose up",
    "healthcheck": "node ./tools/healthcheck.js",
    "test-email": "npx ts-node ./tools/test-email.ts"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "description": "",
