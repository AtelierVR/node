    "json-schema-ref-parser": "^9.0.9",
    "multer": "^2.0.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^7.0.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "speakeasy": "^2.0.0",
    "undici": "^6.19.7",
    "ws": "^8.18.0",
    "prisma": "^6.5.0"
  }
}
