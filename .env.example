SUPPORTED_WORLD_ASSET_PLATFORM=windows,linux,macos,android,ios

# User settings
DEFAULT_USER_TAGS="dft:can_file_upload,dft:can_self_edit,dft:can_world_create,dft:can_world_asset_create,dft:can_world_delete,dft:can_world_edit,dft:can_world_asset_update,dft:fetch_external"
