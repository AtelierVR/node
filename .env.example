# Node settings
NODE_PORT=53032

# Database settings
POSTGRES_IP=10.12.0.3
POSTGRES_PORT=5432
POSTGRES_USER=noxnode
POSTGRES_PASSWORD=
POSTGRES_DB=noxnode

# =================================================================
# Storage Providers
# =================================================================
# Select the file and database backends.
#   FILE_PROVIDER      = local | supabase   (default: local)
#   DATABASE_PROVIDER  = postgres | supabase (default: postgres)
# FILE_PROVIDER=local
# DATABASE_PROVIDER=postgres

# Local file storage — directory where assets are saved on disk.
# Defaults to <cwd>/assets when not set.
# ASSETS_DIR=/var/nox/assets

# -- Supabase (FILE_PROVIDER=supabase and/or DATABASE_PROVIDER=supabase) ------
# Requires: npm install @supabase/supabase-js  (in node/)
#
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role_key>
# SUPABASE_BUCKET=assets
#
# When DATABASE_PROVIDER=supabase, point DATABASE_URL at Supabase Postgres.
# Use the "Transaction pooler" URL from the Supabase dashboard:
# DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# =================================================================

# General settings
# TITLE=NoxVR
# DESCRIPTION=Welcome to the official Dev NoxVR Node server!
# ICON_URL=https://avr.cloud/icon.png
CONTACT=contact@example.com
# WEB_GATEWAY=https://app.avr.cloud

# Admin settings
ADMIN_ID=1
ADMIN_USERNAME=admin
ADMIN_DISPLAY=Admin
ADMIN_PASSWORD=

# World settings
SUPPORTED_WORLD_ASSET_ENGINE=unity
SUPPORTED_WORLD_ASSET_PLATFORM=windows,linux,macos,android,ios

# User settings
DEFAULT_USER_TAGS="dft:can_file_upload,dft:can_self_edit,dft:can_world_create,dft:can_world_asset_create,dft:can_world_delete,dft:can_world_edit,dft:can_world_asset_update,dft:fetch_external"
# DEFAULT_NETUSER_TAGS=
# CAN_REGISTER=true
# SESSION_EXPIRATION=2592000000

# Relay settings
# DOCKER_OPTIONS={}
# DOCKER_IMAGE=your-dockerhub-username/noxrelay

# HTTP settings
# ADDRESS=avr.cloud
# GATEWAY=avr.cloud:53032
# WEB_GATEWAY=https://app.avr.cloud
# IGNORE_LOG_PATHS=/.well-known/nox
# USE_SSL=false
# SECURE=true
# RSA_PUBLICKEY_FILE=certs/public.pem
# RSA_PRIVATEKEY_FILE=certs/private.pem
# RSA_CERTIFICATE_FILE=certs/cert.pem
# HIDE_IP=false
CUSTOM_CORS={"/":{"origin":["http://localhost:3000"],"credentials":true}}

# =================================================================
# Email Configuration
# =================================================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=your-email@gmail.com
# EMAIL_FROM_NAME=NoxVR Server

# Email testing configuration
# TEST_EMAIL=test@example.com
