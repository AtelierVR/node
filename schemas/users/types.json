{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "identifier": {
            "type": "string",
            "pattern": "^([0-9]+|[a-z0-9_.-]{3,16})@(::|[a-zA-Z0-9_.-]+)$"
        },
        "id": {
            "type": "integer",
            "minimum": 1
        },
        "username": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]{3,16}$"
        },
        "display": {
            "type": "string",
            "pattern": "^.{3,32}$"
        },
        "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128
        }
    }
}