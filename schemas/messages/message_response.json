{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "conversation_id", "sender_ref", "content", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Message ID"
    },
    "conversation_id": {
      "type": "string",
      "description": "Conversation ID"
    },
    "sender": {
      "type": "string",
      "description": "Sender reference (user_id@server)"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "attachments": {
      "type": "array",
      "description": "Optional attachments",
      "items": {
        "type": "object"
      }
    },
    "reply_to": {
      "type": ["string", "null"],
      "description": "ID of the message being replied to"
    },
    "created_at": {
      "type": "string",
      "description": "ISO date string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "description": "ISO date string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
