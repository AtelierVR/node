{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "send_message",
    "description": "Schema for sending a message to a conversation",
    "type": "object",
    "properties": {
        "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Message content"
        },
        "attachments": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": { "type": "string" },
                    "url": { "type": "string" },
                    "size": { "type": "number" },
                    "mime": { "type": "string" },
                    "filename": { "type": "string" }
                },
                "required": ["type", "url", "size", "mime"]
            },
            "description": "Optional attachments"
        },
        "reply_to": {
            "type": "string",
            "description": "ID of the message being replied to"
        },
        "sender": {
            "type": "string",
            "pattern": "^[0-9]+@[a-z0-9.-]+$",
            "description": "Optional sender reference (used when a server relays for a user)"
        }
    },
    "required": ["content"],
    "additionalProperties": false
}
