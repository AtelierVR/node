{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "expose": {
            "type": "boolean",
            "description": "Whether the instance should be exposed to the public. If false, only the players known the identifier can access the instance."
        },
        "world": {
            "$ref": "../worlds/types.json#/definitions/identifier"
        },
        "capacity": {
            "type": "number",
            "minimum": 0,
            "description": "The maximum number of users that can be in the instance at the same time. 0 means no limit."
        },
        "use_password": {
            "type": "boolean",
            "default": false
        },
        "password": {
            "type": "string",
            "minLength": 3
        },
        "use_whitelist": {
            "type": "boolean",
            "default": false
        },
        "whitelist": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "../users/types.json#/definitions/identifier"
            }
        },
        "thumbnail": {
            "$ref": "../types.json#/definitions/url"
        }
    },
    "required": [
        "expose",
        "world",
        "capacity"
    ],
    "allOf": [
        {
            "if": {
                "properties": {
                    "use_whitelist": {
                        "const": true,
                        "default": false
                    }
                }
            },
            "then": {
                "required": [
                    "whitelist"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "use_password": {
                        "const": true,
                        "default": false
                    }
                }
            },
            "then": {
                "required": [
                    "password"
                ]
            }
        }
    ]
}