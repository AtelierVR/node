{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "relations/create",
    "title": "Relation Create Schema",
    "type": "object",
    "properties": {
        "user_id": {
            "type": "integer",
            "minimum": 1
        },
        "type": {
            "type": "string",
            "enum": ["follow", "friend", "block"]
        },
        "message": {
            "type": "string",
            "maxLength": 500
        }
    },
    "required": [
        "user_id",
        "type"
    ],
    "additionalProperties": false
}
