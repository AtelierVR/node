{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "relations/create",
    "title": "Relation Create Schema",
    "type": "object",
    "properties": {
        "initiator": {
            "type": "integer",
            "minimum": 1
        },
        "type": {
            "type": "string",
            "enum": ["follow", "unfollow", "follow_accept", "follow_refuse"]
        },
        "target": {
            "type": "integer",
            "minimum": 1
        }
    },
    "required": [
        "initiator",
        "type",
        "target"
    ],
    "additionalProperties": false
}
