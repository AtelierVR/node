{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "presence/user",
    "title": "User Presence Schema",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "enum": ["status", "location"]
        },
        "status": {
            "type": "string",
            "enum": ["online", "away", "busy", "offline"]
        },
        "message": {
            "type": "string",
            "maxLength": 100
        },
        "instance_id": {
            "type": "string"
        },
        "world_id": {
            "type": "integer"
        }
    },
    "required": [
        "type"
    ],
    "additionalProperties": false
}
