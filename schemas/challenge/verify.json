    "$id": "challenge/verify",
    "title": "Challenge Verify Schema",
    "type": "object",
    "properties": {
        "challenge": {
            "type": "string",
            "minLength": 1
        },
        "signature": {
            "type": "string",
            "minLength": 1
        },
        "address": {
            "type": "string",
            "minLength": 1
        }
    },
    "required": [
