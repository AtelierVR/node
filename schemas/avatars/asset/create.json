{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "avatars/asset/create",
    "title": "Create Avatar Asset Schema",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
        },
        "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
        },
        "engine": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "platform": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "url": {
            "$ref": "../../types.json#/definitions/url"
        },
        "hash": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
        },
        "size": {
            "type": "integer",
            "minimum": 0
        }
    },
    "required": ["version", "engine", "platform"],
    "additionalProperties": false
}
