{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "totp/enable",
    "title": "TOTP Enable Schema",
    "type": "object",
    "properties": {
        "secret": {
            "type": "string",
            "minLength": 1
        },
        "token": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
        }
    },
    "required": [
        "secret",
        "token"
    ],
    "additionalProperties": false
}
