{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "relay/checkbearer",
    "title": "Relay Check Bearer Schema",
    "type": "object",
    "properties": {
        "access_token": {
            "type": "string",
            "minLength": 1
        },
        "token_type": {
            "type": "string",
            "enum": [
                "bearer",
                "integrity"
            ]
        },
        "ip": {
            "type": "string",
            "pattern": "^((25[0-5]|(2[0-4]|1[0-9]|[1-9]?)[0-9])\\.){3}(25[0-5]|(2[0-4]|1[0-9]|[1-9]?)[0-9])$",
            "description": "IP address and optional port of the client"
        }
    },
    "required": [
        "access_token",
        "token_type"
    ],
    "additionalProperties": false
}