{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "relay/instance",
    "title": "Relay Instance Schema",
    "type": "object",
    "properties": {
        "internal_id": {
            "type": "integer",
            "minimum": 0,
            "description": "Internal identifier for the instance"
        },
        "master_id": {
            "type": "integer",
            "minimum": 0,
            "description": "Master server identifier"
        },
        "flags": {
            "type": "integer",
            "minimum": 0,
            "description": "Bitfield for instance flags (public, private, etc.)"
        },
        "players": {
            "type": "array",
            "items": {
                "$ref": "player.json"
            },
            "description": "List of players in this instance"
        },
        "max_players": {
            "type": "integer",
            "minimum": 0,
            "description": "Maximum number of players allowed in this instance"
        }
    },
    "required": ["internal_id", "master_id", "flags", "players", "max_players"],
    "additionalProperties": false
}
