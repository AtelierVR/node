{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "worlds/update",
    "title": "Update World Schema",
    "type": "object",
    "properties": {
        "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
        },
        "description": {
            "type": "string",
            "maxLength": 4096
        },
        "capacity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
        },
        "thumbnail": {
            "$ref": "../types.json#/definitions/url"
        },
        "contributors": {
            "type": "array",
            "items": {
                "type": "string",
                "$ref": "../users/types.json#/definitions/identifier"
            }
        }
    },
    "additionalProperties": false
}
