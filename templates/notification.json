{
  "subject": "New notification from {{serverName}}",
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>New Notification - {{serverName}}</title><style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Inter',system-ui,-apple-system,sans-serif;line-height:1.6;color:#171717;background-color:#ffffff;margin:0;padding:0}@media (prefers-color-scheme:dark){body{color:#ededed;background-color:#000}}.email-container{max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.email-container{background:#000;border-color:#27272a}}.header{background:#ffffff;padding:32px;text-align:center;border-bottom:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.header{background:#000;border-color:#27272a}}.logo{font-size:24px;font-weight:700;color:#171717;margin-bottom:8px}@media (prefers-color-scheme:dark){.logo{color:#ededed}}.tagline{font-size:14px;color:#71717a;font-weight:500}@media (prefers-color-scheme:dark){.tagline{color:#a1a1aa}}.content{padding:32px;background:#ffffff}@media (prefers-color-scheme:dark){.content{background:#000}}.greeting{font-size:20px;font-weight:600;color:#171717;margin-bottom:16px}@media (prefers-color-scheme:dark){.greeting{color:#ededed}}.text{font-size:16px;color:#52525b;margin-bottom:16px;line-height:1.7}@media (prefers-color-scheme:dark){.text{color:#a1a1aa}}.notification-card{background:#f4f4f5;border:1px solid #e4e4e7;border-left:4px solid #171717;border-radius:8px;padding:16px;margin:24px 0}@media (prefers-color-scheme:dark){.notification-card{background:#18181b;border-color:#27272a;border-left-color:#ededed}}.notification-type{color:#71717a;font-weight:500;text-transform:uppercase;font-size:12px;letter-spacing:1px;margin-bottom:8px}@media (prefers-color-scheme:dark){.notification-type{color:#a1a1aa}}.notification-title{font-size:18px;font-weight:600;color:#171717;margin-bottom:8px}@media (prefers-color-scheme:dark){.notification-title{color:#ededed}}.notification-message{color:#52525b;font-size:16px;line-height:1.6;margin-bottom:8px}@media (prefers-color-scheme:dark){.notification-message{color:#a1a1aa}}.notification-timestamp{color:#71717a;font-size:12px}@media (prefers-color-scheme:dark){.notification-timestamp{color:#a1a1aa}}.button-container{text-align:center;margin:32px 0}.button{display:inline-block;background:#171717;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:6px;font-weight:500;font-size:16px;transition:background-color 0.2s ease}@media (prefers-color-scheme:dark){.button{background:#ededed;color:#000}}.button:hover{background:#000000}@media (prefers-color-scheme:dark){.button:hover{background:#ffffff}}.footer{background:#f4f4f5;padding:24px;text-align:center;border-top:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.footer{background:#18181b;border-color:#27272a}}.footer-text{font-size:14px;color:#71717a;line-height:1.6}@media (prefers-color-scheme:dark){.footer-text{color:#a1a1aa}}.footer-unsubscribe{margin-top:8px;font-size:12px;color:#71717a}@media (prefers-color-scheme:dark){.footer-unsubscribe{color:#a1a1aa}}.divider{height:1px;background:#e4e4e7;margin:24px 0}@media (prefers-color-scheme:dark){.divider{background:#27272a}}@media (max-width:600px){.email-container{margin:0 16px;border-radius:8px}.header,.content,.footer{padding:24px}}</style></head><body><div class=\"email-container\"><div class=\"header\"><div class=\"logo\">{{serverName}}</div><div class=\"tagline\">New notification</div></div><div class=\"content\"><div class=\"greeting\">Hello {{display}},</div><p class=\"text\">You have received a new notification on {{serverName}}:</p><div class=\"notification-card\"><div class=\"notification-type\">{{notificationType}}</div><div class=\"notification-title\">{{notificationTitle}}</div><div class=\"notification-message\">{{notificationMessage}}</div><div class=\"notification-timestamp\">Received: {{timestamp}}</div></div><p class=\"text\">You can view all your notifications in your dashboard:</p><div class=\"button-container\"><a href=\"{{dashboardUrl}}\" class=\"button\">View notifications</a></div><div class=\"divider\"></div><p class=\"text\">Best regards,<br><strong>The {{serverName}} Team</strong></p></div><div class=\"footer\"><p class=\"footer-text\">This email was sent from {{serverUrl}}<br>© {{serverName}} - All rights reserved</p><p class=\"footer-unsubscribe\">To unsubscribe from notification emails, visit your account settings</p></div></div></body></html>",
  "text": "New Notification from {{serverName}}\n\nHello {{display}},\n\nYou have received a new notification on {{serverName}}:\n\nType: {{notificationType}}\nTitle: {{notificationTitle}}\nMessage: {{notificationMessage}}\nReceived: {{timestamp}}\n\nYou can view all your notifications in your dashboard at:\n{{dashboardUrl}}\n\nBest regards,\nThe {{serverName}} Team\n\nThis email was sent from {{serverUrl}}\n© {{serverName}} - All rights reserved\n\nTo unsubscribe from notification emails, visit your account settings."
}
