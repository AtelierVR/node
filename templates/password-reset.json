{
  "subject": "Reset your password - {{serverName}}",
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Password Reset - {{serverName}}</title><style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Inter',system-ui,-apple-system,sans-serif;line-height:1.6;color:#171717;background-color:#ffffff;margin:0;padding:0}@media (prefers-color-scheme:dark){body{color:#ededed;background-color:#000}}.email-container{max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.email-container{background:#000;border-color:#27272a}}.header{background:#ffffff;padding:32px;text-align:center;border-bottom:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.header{background:#000;border-color:#27272a}}.logo{font-size:24px;font-weight:700;color:#171717;margin-bottom:8px}@media (prefers-color-scheme:dark){.logo{color:#ededed}}.tagline{font-size:14px;color:#71717a;font-weight:500}@media (prefers-color-scheme:dark){.tagline{color:#a1a1aa}}.content{padding:32px;background:#ffffff}@media (prefers-color-scheme:dark){.content{background:#000}}.greeting{font-size:20px;font-weight:600;color:#171717;margin-bottom:16px}@media (prefers-color-scheme:dark){.greeting{color:#ededed}}.text{font-size:16px;color:#52525b;margin-bottom:16px;line-height:1.7}@media (prefers-color-scheme:dark){.text{color:#a1a1aa}}.user-card{background:#f4f4f5;border:1px solid #e4e4e7;border-radius:8px;padding:16px;margin:24px 0}@media (prefers-color-scheme:dark){.user-card{background:#18181b;border-color:#27272a}}.user-label{font-size:14px;font-weight:500;color:#71717a;margin-bottom:4px}@media (prefers-color-scheme:dark){.user-label{color:#a1a1aa}}.user-value{font-size:16px;font-weight:600;color:#171717}@media (prefers-color-scheme:dark){.user-value{color:#ededed}}.button-container{text-align:center;margin:32px 0}.button{display:inline-block;background:#dc2626;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:6px;font-weight:500;font-size:16px;transition:background-color 0.2s ease}.button:hover{background:#b91c1c}.warning{background:#fef3c7;border:1px solid #fbbf24;border-radius:8px;padding:16px;margin:24px 0}@media (prefers-color-scheme:dark){.warning{background:#451a03;border-color:#92400e}}.warning-text{color:#92400e;font-size:14px;line-height:1.6;font-weight:500}@media (prefers-color-scheme:dark){.warning-text{color:#fbbf24}}.link-fallback{background:#f4f4f5;border:1px solid #e4e4e7;border-radius:6px;padding:16px;margin:24px 0;word-break:break-all;font-size:14px;color:#52525b;font-family:monospace}@media (prefers-color-scheme:dark){.link-fallback{background:#18181b;border-color:#27272a;color:#a1a1aa}}.footer{background:#f4f4f5;padding:24px;text-align:center;border-top:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.footer{background:#18181b;border-color:#27272a}}.footer-text{font-size:14px;color:#71717a;line-height:1.6}@media (prefers-color-scheme:dark){.footer-text{color:#a1a1aa}}.divider{height:1px;background:#e4e4e7;margin:24px 0}@media (prefers-color-scheme:dark){.divider{background:#27272a}}@media (max-width:600px){.email-container{margin:0 16px;border-radius:8px}.header,.content,.footer{padding:24px}}</style></head><body><div class=\"email-container\"><div class=\"header\"><div class=\"logo\">{{serverName}}</div><div class=\"tagline\">Password reset request</div></div><div class=\"content\"><div class=\"greeting\">Hello {{display}},</div><p class=\"text\">We received a request to reset the password for your account. If you made this request, you can proceed with resetting your password using the link below.</p><div class=\"user-card\"><div class=\"user-label\">Account details</div><div class=\"user-value\">{{username}}@{{serverName}}</div></div><div class=\"button-container\"><a href=\"{{resetUrl}}\" class=\"button\">Reset password</a></div><div class=\"warning\"><div class=\"warning-text\">This password reset link will expire in {{expiresIn}} for your security. If you didn't request a password reset, please ignore this email.</div></div><div class=\"divider\"></div><p class=\"text\">If the button above doesn't work, you can copy and paste this link into your browser:</p><div class=\"link-fallback\">{{resetUrl}}</div><p class=\"text\">If you continue to receive password reset emails that you didn't request, please contact our support team.</p><p class=\"text\">Best regards,<br><strong>The {{serverName}} Team</strong></p></div><div class=\"footer\"><p class=\"footer-text\">This email was sent from {{serverUrl}}<br>© {{serverName}} - All rights reserved</p></div></div></body></html>",
  "text": "Password Reset Request\n\nHello {{display}},\n\nWe received a request to reset the password for your account. If you made this request, you can proceed with resetting your password using the link below.\n\nAccount details: {{username}}@{{serverName}}\n\nPlease click the following link to reset your password:\n{{resetUrl}}\n\nThis password reset link will expire in {{expiresIn}} for your security. If you didn't request a password reset, please ignore this email.\n\nIf you continue to receive password reset emails that you didn't request, please contact our support team.\n\nBest regards,\nThe {{serverName}} Team\n\nThis email was sent from {{serverUrl}}\n© {{serverName}} - All rights reserved"
}
