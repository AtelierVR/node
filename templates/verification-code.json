{
    "subject": "Your verification code for {{serverName}}",
    "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Verification Code - {{serverName}}</title><style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Inter',system-ui,-apple-system,sans-serif;line-height:1.6;color:#171717;background-color:#ffffff;margin:0;padding:0}@media (prefers-color-scheme:dark){body{color:#ededed;background-color:#000}}.email-container{max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.email-container{background:#000;border-color:#27272a}}.header{background:#ffffff;padding:32px;text-align:center;border-bottom:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.header{background:#000;border-color:#27272a}}.logo{font-size:24px;font-weight:700;color:#171717;margin-bottom:8px}@media (prefers-color-scheme:dark){.logo{color:#ededed}}.tagline{font-size:14px;color:#71717a;font-weight:500}@media (prefers-color-scheme:dark){.tagline{color:#a1a1aa}}.content{padding:32px;background:#ffffff}@media (prefers-color-scheme:dark){.content{background:#000}}.greeting{font-size:20px;font-weight:600;color:#171717;margin-bottom:16px}@media (prefers-color-scheme:dark){.greeting{color:#ededed}}.text{font-size:16px;color:#52525b;margin-bottom:16px;line-height:1.7}@media (prefers-color-scheme:dark){.text{color:#a1a1aa}}.code-container{background:#f4f4f5;border:2px solid #171717;border-radius:8px;padding:24px;text-align:center;margin:24px 0}@media (prefers-color-scheme:dark){.code-container{background:#18181b;border-color:#ededed}}.code-label{font-size:14px;font-weight:500;color:#71717a;margin-bottom:12px;text-transform:uppercase;letter-spacing:0.5px}@media (prefers-color-scheme:dark){.code-label{color:#a1a1aa}}.verification-code{font-size:36px;font-weight:700;letter-spacing:4px;color:#171717;font-family:'Inter',monospace;margin-bottom:12px}@media (prefers-color-scheme:dark){.verification-code{color:#ededed}}.code-helper{font-size:12px;color:#71717a;font-weight:500}@media (prefers-color-scheme:dark){.code-helper{color:#a1a1aa}}.warning{background:#fef3c7;border:1px solid #fbbf24;border-radius:8px;padding:16px;margin:24px 0}@media (prefers-color-scheme:dark){.warning{background:#451a03;border-color:#92400e}}.warning-title{font-weight:600;color:#92400e;margin-bottom:8px}@media (prefers-color-scheme:dark){.warning-title{color:#fbbf24}}.warning-text{color:#92400e;font-size:14px;line-height:1.6}@media (prefers-color-scheme:dark){.warning-text{color:#fbbf24}}.footer{background:#f4f4f5;padding:24px;text-align:center;border-top:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.footer{background:#18181b;border-color:#27272a}}.footer-text{font-size:14px;color:#71717a;line-height:1.6}@media (prefers-color-scheme:dark){.footer-text{color:#a1a1aa}}.divider{height:1px;background:#e4e4e7;margin:24px 0}@media (prefers-color-scheme:dark){.divider{background:#27272a}}@media (max-width:600px){.email-container{margin:0 16px;border-radius:8px}.header,.content,.footer{padding:24px}.verification-code{font-size:28px;letter-spacing:2px}.code-container{padding:20px}}</style></head><body><div class=\"email-container\"><div class=\"header\"><div class=\"logo\">{{serverName}}</div><div class=\"tagline\">Verification code</div></div><div class=\"content\"><div class=\"greeting\">Hello {{display}},</div><p class=\"text\">You are trying to sign in to your account. To complete your login securely, please enter the verification code below:</p><div class=\"code-container\"><div class=\"code-label\">Your verification code</div><div class=\"verification-code\">{{verificationCode}}</div><div class=\"code-helper\">Enter this code in your browser</div></div><div class=\"warning\"><div class=\"warning-title\">Important security information</div><div class=\"warning-text\">This code will expire in {{expiresIn}} for your security. Do not share this code with anyone. If you didn't request this verification code, please ignore this email.</div></div><div class=\"divider\"></div><p class=\"text\">If you continue to experience issues or have concerns about your account security, please contact our support team.</p><p class=\"text\">Best regards,<br><strong>The {{serverName}} Team</strong></p></div><div class=\"footer\"><p class=\"footer-text\">This email was sent from {{serverUrl}}<br>© {{serverName}} - All rights reserved</p></div></div></body></html>",
    "text": "{{serverName}} - Verification Code\n\nHello {{display}},\n\nYou are trying to sign in to your account. To complete your login securely, please enter the verification code below:\n\nVerification Code: {{verificationCode}}\n\nImportant security information: This code will expire in {{expiresIn}} for your security. Do not share this code with anyone. If you didn't request this verification code, please ignore this email.\n\nIf you continue to experience issues or have concerns about your account security, please contact our support team.\n\nBest regards,\nThe {{serverName}} Team\n\nThis email was sent from {{serverUrl}}\n© {{serverName}} - All rights reserved"
}
