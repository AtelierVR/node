{
  "subject": "Action required: {{actionType}} - {{serverName}}",
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Action Required - {{serverName}}</title><style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Inter',system-ui,-apple-system,sans-serif;line-height:1.6;color:#171717;background-color:#ffffff;margin:0;padding:0}@media (prefers-color-scheme:dark){body{color:#ededed;background-color:#000}}.email-container{max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.email-container{background:#000;border-color:#27272a}}.header{background:#ffffff;padding:32px;text-align:center;border-bottom:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.header{background:#000;border-color:#27272a}}.logo{font-size:24px;font-weight:700;color:#171717;margin-bottom:8px}@media (prefers-color-scheme:dark){.logo{color:#ededed}}.tagline{font-size:14px;color:#71717a;font-weight:500}@media (prefers-color-scheme:dark){.tagline{color:#a1a1aa}}.content{padding:32px;background:#ffffff}@media (prefers-color-scheme:dark){.content{background:#000}}.greeting{font-size:20px;font-weight:600;color:#171717;margin-bottom:16px}@media (prefers-color-scheme:dark){.greeting{color:#ededed}}.text{font-size:16px;color:#52525b;margin-bottom:16px;line-height:1.7}@media (prefers-color-scheme:dark){.text{color:#a1a1aa}}.action-card{border-left:4px solid #dc2626;border-radius:8px;padding:16px;margin:24px 0;background:#f4f4f5;border:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.action-card{background:#18181b;border-color:#27272a}}.urgency-high{border-left-color:#dc2626;background:#fef2f2}@media (prefers-color-scheme:dark){.urgency-high{background:#450a0a}}.urgency-medium{border-left-color:#f97316;background:#fff7ed}@media (prefers-color-scheme:dark){.urgency-medium{background:#431407}}.urgency-low{border-left-color:#16a34a;background:#f0fdf4}@media (prefers-color-scheme:dark){.urgency-low{background:#052e16}}.action-title{font-size:18px;font-weight:600;color:#171717;margin-bottom:12px}@media (prefers-color-scheme:dark){.action-title{color:#ededed}}.action-detail{display:flex;justify-content:space-between;margin-bottom:8px;font-size:14px}.action-label{color:#71717a;font-weight:500}@media (prefers-color-scheme:dark){.action-label{color:#a1a1aa}}.action-value{color:#171717;font-weight:600}@media (prefers-color-scheme:dark){.action-value{color:#ededed}}.priority-badge{display:inline-block;padding:4px 12px;border-radius:12px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px}.priority-high{background-color:#dc2626;color:#ffffff}.priority-medium{background-color:#f97316;color:#ffffff}.priority-low{background-color:#16a34a;color:#ffffff}.button-container{text-align:center;margin:32px 0}.button{display:inline-block;background:#dc2626;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:6px;font-weight:500;font-size:16px;transition:background-color 0.2s ease}.button:hover{background:#b91c1c}.footer{background:#f4f4f5;padding:24px;text-align:center;border-top:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.footer{background:#18181b;border-color:#27272a}}.footer-text{font-size:14px;color:#71717a;line-height:1.6}@media (prefers-color-scheme:dark){.footer-text{color:#a1a1aa}}.footer-deadline{margin-top:8px;font-size:12px;color:#dc2626;font-weight:600}@media (prefers-color-scheme:dark){.footer-deadline{color:#f87171}}.divider{height:1px;background:#e4e4e7;margin:24px 0}@media (prefers-color-scheme:dark){.divider{background:#27272a}}@media (max-width:600px){.email-container{margin:0 16px;border-radius:8px}.header,.content,.footer{padding:24px}.action-detail{flex-direction:column;gap:4px}}</style></head><body><div class=\"email-container\"><div class=\"header\"><div class=\"logo\">{{serverName}}</div><div class=\"tagline\">Action required</div></div><div class=\"content\"><div class=\"greeting\">Hello {{display}},</div><p class=\"text\">An important action is required on your account. Please review the details below and take action promptly.</p><div class=\"action-card urgency-{{urgency}}\"><div class=\"action-title\">{{actionType}}</div><div class=\"action-detail\"><span class=\"action-label\">Description:</span><span class=\"action-value\">{{description}}</span></div><div class=\"action-detail\"><span class=\"action-label\">Deadline:</span><span class=\"action-value\">{{deadline}}</span></div><div class=\"action-detail\"><span class=\"action-label\">Priority:</span><span class=\"priority-badge priority-{{urgency}}\">{{urgency}}</span></div>{{#if details}}<div class=\"action-detail\"><span class=\"action-label\">Details:</span><span class=\"action-value\">{{details}}</span></div>{{/if}}</div><p class=\"text\">Please take action as soon as possible:</p><div class=\"button-container\"><a href=\"{{actionUrl}}\" class=\"button\">Take action now</a></div><div class=\"divider\"></div><p class=\"text\">If you have any questions or need assistance, please contact our support team.</p><p class=\"text\">Best regards,<br><strong>The {{serverName}} Team</strong></p></div><div class=\"footer\"><p class=\"footer-text\">This email was sent from {{serverUrl}}<br>© {{serverName}} - All rights reserved</p><p class=\"footer-deadline\">This action expires on {{deadline}}</p></div></div></body></html>",
  "text": "Action Required: {{actionType}} - {{serverName}}\n\nHello {{display}},\n\nAn important action is required on your account. Please review the details below and take action promptly.\n\nAction Type: {{actionType}}\nDescription: {{description}}\nDeadline: {{deadline}}\nPriority: {{urgency}}\n\nDetails: {{details}}\n\nPlease take action as soon as possible by visiting:\n{{actionUrl}}\n\nIf you have any questions or need assistance, please contact our support team.\n\nBest regards,\nThe {{serverName}} Team\n\nThis email was sent from {{serverUrl}}\n© {{serverName}} - All rights reserved\n\nThis action expires on {{deadline}}"
}
