{
  "subject": "Welcome to {{serverName}}",
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Welcome to {{serverName}}</title><style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Inter',system-ui,-apple-system,sans-serif;line-height:1.6;color:#171717;background-color:#ffffff;margin:0;padding:0}@media (prefers-color-scheme:dark){body{color:#ededed;background-color:#000}}.email-container{max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.email-container{background:#000;border-color:#27272a}}.header{background:#ffffff;padding:32px;text-align:center;border-bottom:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.header{background:#000;border-color:#27272a}}.logo{font-size:24px;font-weight:700;color:#171717;margin-bottom:8px}@media (prefers-color-scheme:dark){.logo{color:#ededed}}.tagline{font-size:14px;color:#71717a;font-weight:500}@media (prefers-color-scheme:dark){.tagline{color:#a1a1aa}}.content{padding:32px;background:#ffffff}@media (prefers-color-scheme:dark){.content{background:#000}}.greeting{font-size:20px;font-weight:600;color:#171717;margin-bottom:16px}@media (prefers-color-scheme:dark){.greeting{color:#ededed}}.text{font-size:16px;color:#52525b;margin-bottom:16px;line-height:1.7}@media (prefers-color-scheme:dark){.text{color:#a1a1aa}}.user-card{background:#f4f4f5;border:1px solid #e4e4e7;border-radius:8px;padding:16px;margin:24px 0}@media (prefers-color-scheme:dark){.user-card{background:#18181b;border-color:#27272a}}.user-label{font-size:14px;font-weight:500;color:#71717a;margin-bottom:4px}@media (prefers-color-scheme:dark){.user-label{color:#a1a1aa}}.user-value{font-size:16px;font-weight:600;color:#171717}@media (prefers-color-scheme:dark){.user-value{color:#ededed}}.button-container{text-align:center;margin:32px 0}.button{display:inline-block;background:#171717;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:6px;font-weight:500;font-size:16px;transition:background-color 0.2s ease}@media (prefers-color-scheme:dark){.button{background:#ededed;color:#000}}.button:hover{background:#000000}@media (prefers-color-scheme:dark){.button:hover{background:#ffffff}}.footer{background:#f4f4f5;padding:24px;text-align:center;border-top:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.footer{background:#18181b;border-color:#27272a}}.footer-text{font-size:14px;color:#71717a;line-height:1.6}@media (prefers-color-scheme:dark){.footer-text{color:#a1a1aa}}.divider{height:1px;background:#e4e4e7;margin:24px 0}@media (prefers-color-scheme:dark){.divider{background:#27272a}}@media (max-width:600px){.email-container{margin:0 16px;border-radius:8px}.header,.content,.footer{padding:24px}}</style></head><body><div class=\"email-container\"><div class=\"header\"><div class=\"logo\">{{serverName}}</div><div class=\"tagline\">Welcome to the platform</div></div><div class=\"content\"><div class=\"greeting\">Hello {{display}},</div><p class=\"text\">Your account has been successfully created and verified. You're now part of the {{serverName}} community.</p><div class=\"user-card\"><div class=\"user-label\">Your account</div><div class=\"user-value\">{{username}}@{{serverName}}</div></div><div class=\"button-container\"><a href=\"{{loginUrl}}\" class=\"button\">Get started</a></div><div class=\"divider\"></div><p class=\"text\">If you have any questions, please don't hesitate to reach out to our support team.</p><p class=\"text\">Best regards,<br><strong>The {{serverName}} Team</strong></p></div><div class=\"footer\"><p class=\"footer-text\">This email was sent from {{serverUrl}}<br>© {{serverName}} - All rights reserved</p></div></div></body></html>",
  "text": "Welcome to {{serverName}}\n\nHello {{display}},\n\nYour account has been successfully created and verified. You're now part of the {{serverName}} community.\n\nYour account: {{username}}@{{serverName}}\n\nGet started by visiting: {{loginUrl}}\n\nIf you have any questions, please don't hesitate to reach out to our support team.\n\nBest regards,\nThe {{serverName}} Team\n\nThis email was sent from {{serverUrl}}\n© {{serverName}} - All rights reserved"
}
