{
  "subject": "Security Alert - {{serverName}}",
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Security Alert - {{serverName}}</title><style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Inter',system-ui,-apple-system,sans-serif;line-height:1.6;color:#171717;background-color:#ffffff;margin:0;padding:0}@media (prefers-color-scheme:dark){body{color:#ededed;background-color:#000}}.email-container{max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.email-container{background:#000;border-color:#27272a}}.header{background:#ffffff;padding:32px;text-align:center;border-bottom:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.header{background:#000;border-color:#27272a}}.logo{font-size:24px;font-weight:700;color:#171717;margin-bottom:8px}@media (prefers-color-scheme:dark){.logo{color:#ededed}}.tagline{font-size:14px;color:#71717a;font-weight:500}@media (prefers-color-scheme:dark){.tagline{color:#a1a1aa}}.content{padding:32px;background:#ffffff}@media (prefers-color-scheme:dark){.content{background:#000}}.greeting{font-size:20px;font-weight:600;color:#171717;margin-bottom:16px}@media (prefers-color-scheme:dark){.greeting{color:#ededed}}.text{font-size:16px;color:#52525b;margin-bottom:16px;line-height:1.7}@media (prefers-color-scheme:dark){.text{color:#a1a1aa}}.user-card{background:#f4f4f5;border:1px solid #e4e4e7;border-radius:8px;padding:16px;margin:24px 0}@media (prefers-color-scheme:dark){.user-card{background:#18181b;border-color:#27272a}}.user-label{font-size:14px;font-weight:500;color:#71717a;margin-bottom:4px}@media (prefers-color-scheme:dark){.user-label{color:#a1a1aa}}.user-value{font-size:16px;font-weight:600;color:#171717}@media (prefers-color-scheme:dark){.user-value{color:#ededed}}.activity-details{background:#fef3c7;border:1px solid #fbbf24;border-radius:8px;padding:16px;margin:24px 0}@media (prefers-color-scheme:dark){.activity-details{background:#451a03;border-color:#92400e}}.activity-title{font-weight:600;color:#92400e;margin-bottom:12px;font-size:16px}@media (prefers-color-scheme:dark){.activity-title{color:#fbbf24}}.activity-item{display:flex;justify-content:space-between;margin-bottom:8px;font-size:14px}.activity-label{color:#92400e;font-weight:500}@media (prefers-color-scheme:dark){.activity-label{color:#fbbf24}}.activity-value{color:#78350f;font-weight:600}@media (prefers-color-scheme:dark){.activity-value{color:#fbbf24}}.button-container{text-align:center;margin:32px 0}.button{display:inline-block;background:#dc2626;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:6px;font-weight:500;font-size:16px;transition:background-color 0.2s ease}.button:hover{background:#b91c1c}.recommendations{background:#f4f4f5;border:1px solid #e4e4e7;border-radius:8px;padding:16px;margin:24px 0}@media (prefers-color-scheme:dark){.recommendations{background:#18181b;border-color:#27272a}}.recommendations-title{font-weight:600;color:#171717;margin-bottom:12px;font-size:16px}@media (prefers-color-scheme:dark){.recommendations-title{color:#ededed}}.recommendations-list{list-style:none;padding:0}.recommendations-item{color:#52525b;margin-bottom:6px;padding-left:16px;position:relative;font-size:14px}@media (prefers-color-scheme:dark){.recommendations-item{color:#a1a1aa}}.recommendations-item:before{content:'•';position:absolute;left:0;color:#71717a}@media (prefers-color-scheme:dark){.recommendations-item:before{color:#a1a1aa}}.footer{background:#f4f4f5;padding:24px;text-align:center;border-top:1px solid #e4e4e7}@media (prefers-color-scheme:dark){.footer{background:#18181b;border-color:#27272a}}.footer-text{font-size:14px;color:#71717a;line-height:1.6}@media (prefers-color-scheme:dark){.footer-text{color:#a1a1aa}}.divider{height:1px;background:#e4e4e7;margin:24px 0}@media (prefers-color-scheme:dark){.divider{background:#27272a}}@media (max-width:600px){.email-container{margin:0 16px;border-radius:8px}.header,.content,.footer{padding:24px}.activity-item{flex-direction:column;gap:4px}}</style></head><body><div class=\"email-container\"><div class=\"header\"><div class=\"logo\">{{serverName}}</div><div class=\"tagline\">Security alert</div></div><div class=\"content\"><div class=\"greeting\">Hello {{display}},</div><p class=\"text\">We detected activity on your account that requires your attention. This security alert was triggered to help protect your account.</p><div class=\"user-card\"><div class=\"user-label\">Account details</div><div class=\"user-value\">{{username}}@{{serverName}}</div></div><div class=\"activity-details\"><div class=\"activity-title\">Activity details</div><div class=\"activity-item\"><span class=\"activity-label\">Activity type:</span><span class=\"activity-value\">{{activityType}}</span></div><div class=\"activity-item\"><span class=\"activity-label\">Time:</span><span class=\"activity-value\">{{timestamp}}</span></div><div class=\"activity-item\"><span class=\"activity-label\">Location:</span><span class=\"activity-value\">{{location}}</span></div><div class=\"activity-item\"><span class=\"activity-label\">IP address:</span><span class=\"activity-value\">{{ipAddress}}</span></div></div><p class=\"text\">If this was you, no action is needed. If you don't recognize this activity, please secure your account immediately:</p><div class=\"button-container\"><a href=\"{{securityUrl}}\" class=\"button\">Secure my account</a></div><div class=\"recommendations\"><div class=\"recommendations-title\">Recommended security actions</div><ul class=\"recommendations-list\"><li class=\"recommendations-item\">Change your password immediately</li><li class=\"recommendations-item\">Enable two-factor authentication if not already active</li><li class=\"recommendations-item\">Review your recent account activity</li><li class=\"recommendations-item\">Check for any unauthorized changes</li><li class=\"recommendations-item\">Log out of all devices and sessions</li></ul></div><div class=\"divider\"></div><p class=\"text\">If you need assistance or have concerns about this alert, please contact our support team.</p><p class=\"text\">Best regards,<br><strong>The {{serverName}} Security Team</strong></p></div><div class=\"footer\"><p class=\"footer-text\">This email was sent from {{serverUrl}}<br>© {{serverName}} - All rights reserved</p></div></div></body></html>",
  "text": "Security Alert\n\nHello {{display}},\n\nWe detected activity on your account that requires your attention. This security alert was triggered to help protect your account.\n\nAccount details: {{username}}@{{serverName}}\n\nActivity details:\nActivity type: {{activityType}}\nTime: {{timestamp}}\nLocation: {{location}}\nIP address: {{ipAddress}}\n\nIf this was you, no action is needed. If you don't recognize this activity, please secure your account immediately by visiting:\n{{securityUrl}}\n\nRecommended security actions:\n- Change your password immediately\n- Enable two-factor authentication if not already active\n- Review your recent account activity\n- Check for any unauthorized changes\n- Log out of all devices and sessions\n\nIf you need assistance or have concerns about this alert, please contact our support team.\n\nBest regards,\nThe {{serverName}} Security Team\n\nThis email was sent from {{serverUrl}}\n© {{serverName}} - All rights reserved"
}
